
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Pravidla pro sezóny (archiv)
    match /seasons/{seasonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Explicitní pravidla pro statistiky (aby se předešlo limitům vnořených cest při hromadných operacích)
    match /users/{userId}/skaterStats/{statsId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /users/{userId}/goalieStats/{statsId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Globální pravidla pro subkolekce (pomáhá při write operacích adminů)
    match /{path=**}/skaterStats/{statsId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /{path=**}/goalieStats/{statsId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Pravidla pro oznámení
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAdmin() || isOwner(userId);
      }

      // Pravidla pro push notifikace (Web Push subscriptions)
      match /pushSubscriptions/{subscriptionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mvpVotes', 'starsVotes']));

      match /attendees/{userId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    match /{path=**}/attendees/{attendeeId} {
      allow get, list: if isSignedIn();
    }
  }
}
