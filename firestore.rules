/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model for all
 * user-specific data, while allowing public read access for shared data like matches.
 * The primary goal is to ensure that users can only access and manage their own
 * information, preventing any unauthorized access to other users' data.
 *
 * Data Structure: Private user data, including profiles and player statistics, is
 * hierarchically organized under the /users/{userId} path. This structure naturally
 * scopes access control. Publicly shared data, such as hockey matches, is stored in a
 * separate top-level collection (/matches) to enable simple, performant public queries.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for improved readability and reusability
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Checks if the user is an admin by reading their profile role
    // We use a safe check to avoid recursion issues
    function isAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Checks if the requesting user's UID matches the document's owner ID
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Allow any signed-in user to see profiles (necessary for leaderboard and admin checks)
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId}/skaterStats/{skaterStatsId} {
      // Admin can manage all stats, owner can manage their own
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner(userId);
    }
    
    match /users/{userId}/goalieStats/{goalieStatsId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner(userId);
    }

    // Collection group rules for global statistics
    match /{path=**}/skaterStats/{statsId} {
        allow read: if isSignedIn();
    }
    
    match /{path=**}/goalieStats/{statsId} {
        allow read: if isSignedIn();
    }

    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /matches/{matchId}/attendees/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /{path=**}/attendees/{attendeeId} {
      allow get, list: if isSignedIn();
    }
  }
}