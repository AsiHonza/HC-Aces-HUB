
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user profile in the Aces Hockey Hub application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "name": {
          "type": "string",
          "description": "Full name of the user."
        },
        "jerseyNumber": {
          "type": "number",
          "description": "Optional jersey number of the user."
        },
        "phoneNumber": {
          "type": "string",
          "description": "Phone number of the user."
        },
        "role": {
            "type": "string",
            "description": "The administrative role of the user.",
            "enum": ["admin", "classic"]
        },
        "playerType": {
            "type": "string",
            "description": "The functional role of the user on the team.",
            "enum": ["player", "goalie", "member"]
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        },
        "dob": {
          "type": "string",
          "format": "date",
          "description": "Date of birth."
        }
      },
      "required": [
        "id",
        "email",
        "name",
        "role",
        "playerType"
      ]
    },
    "Match": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Match",
      "type": "object",
      "description": "Represents a hockey match, played or upcoming.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Match entity."
        },
        "seasonId": {
          "type": "string",
          "description": "Identifier of the season this match belongs to."
        },
        "dateTime": {
          "type": "string",
          "description": "Date and time of the match.",
          "format": "date-time"
        },
        "location": {
          "type": "string",
          "description": "Location where the match will be held."
        },
        "team1": {
          "type": "string",
          "description": "Name of the first team."
        },
        "team2": {
          "type": "string",
          "description": "Name of the second team."
        },
        "isPlayed": {
          "type": "boolean",
          "description": "Indicates if the match has been played and a result has been recorded."
        },
        "isStatsExported": {
          "type": "boolean",
          "description": "Indicates if the match statistics have been exported to player stats."
        },
        "type": {
          "type": "string",
          "description": "The type of the match.",
          "enum": [
            "regular",
            "playoff",
            "friendly"
          ]
        },
        "round": {
          "type": "number",
          "description": "Round number for regular season matches."
        },
        "playoffStage": {
          "type": "string",
          "description": "The stage of the playoff match.",
          "enum": [
            "čtvrtfinále",
            "semifinále",
            "finále"
          ]
        },
        "playoffMatchNumber": {
          "type": "number",
          "description": "The sequence number of the match within a playoff stage series."
        },
        "team1Score": {
          "type": "number",
          "description": "Final score for team 1 (usually Aces)."
        },
        "team2Score": {
          "type": "number",
          "description": "Final score for the opponent team."
        },
        "scorers": {
          "type": "array",
          "description": "An array of objects detailing each goal scored by the home team.",
          "items": {
            "type": "object",
            "properties": {
              "goal": {
                "type": "string",
                "description": "The user ID of the player who scored the goal."
              },
              "assist": {
                "type": "string",
                "description": "The user ID of the player who assisted on the goal."
              }
            },
            "required": [
              "goal"
            ]
          }
        },
        "lineup": {
          "type": "object",
          "description": "Stores the saved lineup for the match, with positions as keys (e.g., LK1, C1) and denormalized player data as values."
        },
        "goalieId": {
            "type": "string",
            "description": "The user ID of the goalie who played in the match."
        },
        "goalieSaves": {
            "type": "number",
            "description": "Number of saves made by the goalie in the match."
        },
        "goalieShotsAgainst": {
            "type": "number",
            "description": "Number of shots against the goalie in the match."
        }
      },
      "required": [
        "id",
        "dateTime",
        "location",
        "team1",
        "team2",
        "isPlayed",
        "type"
      ]
    },
    "SkaterStats": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SkaterStats",
      "type": "object",
      "description": "Represents the statistics of a skater, categorized by season, playoff, and all-time history.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the SkaterStats entity."
        },
        "userProfileId": {
          "type": "string",
          "description": "Reference to UserProfile. (Relationship: UserProfile 1:1 SkaterStats)"
        },
        "seasonGoals": {
          "type": "number",
          "description": "Number of goals scored by the player in the current regular season."
        },
        "seasonAssists": {
          "type": "number",
          "description": "Number of assists made by the player in the current regular season."
        },
        "seasonGamesPlayed": {
          "type": "number",
          "description": "Number of games played by the player in the current regular season."
        },
        "playoffGoals": {
          "type": "number",
          "description": "Number of goals scored by the player in the current playoffs."
        },
        "playoffAssists": {
          "type": "number",
          "description": "Number of assists made by the player in the current playoffs."
        },
        "playoffGamesPlayed": {
          "type": "number",
          "description": "Number of games played by the player in the current playoffs."
        },
        "historicalGoals": {
          "type": "number",
          "description": "Total number of goals scored by the player in their career."
        },
        "historicalAssists": {
          "type": "number",
          "description": "Total number of assists made by the player in their career."
        },
        "historicalGamesPlayed": {
          "type": "number",
          "description": "Total number of games played by the player in their career."
        }
      },
      "required": [
        "id",
        "userProfileId",
        "seasonGoals",
        "seasonAssists",
        "seasonGamesPlayed",
        "playoffGoals",
        "playoffAssists",
        "playoffGamesPlayed",
        "historicalGoals",
        "historicalAssists",
        "historicalGamesPlayed"
      ]
    },
     "GoalieStats": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GoalieStats",
      "type": "object",
      "description": "Represents the statistics of a goalie, categorized by season, playoff, and all-time history.",
      "properties": {
        "id": { "type": "string" },
        "userProfileId": { "type": "string" },
        "seasonGamesPlayed": { "type": "number" },
        "seasonWins": { "type": "number" },
        "seasonShotsAgainst": { "type": "number" },
        "seasonSaves": { "type": "number" },
        "seasonSO": { "type": "number", "description": "Number of shutouts in the current regular season." },
        "playoffGamesPlayed": { "type": "number" },
        "playoffWins": { "type": "number" },
        "playoffShotsAgainst": { "type": "number" },
        "playoffSaves": { "type": "number" },
        "playoffSO": { "type": "number", "description": "Number of shutouts in the current playoffs." },
        "historicalGamesPlayed": { "type": "number" },
        "historicalWins": { "type": "number" },
        "historicalShotsAgainst": { "type": "number" },
        "historicalSaves": { "type": "number" },
        "historicalSO": { "type": "number", "description": "Total number of shutouts in career." }
      },
      "required": [
        "id",
        "userProfileId",
        "seasonGamesPlayed",
        "seasonWins",
        "seasonShotsAgainst",
        "seasonSaves",
        "seasonSO",
        "playoffGamesPlayed",
        "playoffWins",
        "playoffShotsAgainst",
        "playoffSaves",
        "playoffSO",
        "historicalGamesPlayed",
        "historicalWins",
        "historicalShotsAgainst",
        "historicalSaves",
        "historicalSO"
      ]
    },
    "Season": {
      "title": "Season",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "year": { "type": "string" },
        "teamCount": { "type": "number" },
        "archivedAt": { "type": "string", "format": "date-time" },
        "standings": { "type": "array" },
        "playoffSeries": { "type": "array" }
      }
    },
    "AppSettings": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AppSettings",
      "type": "object",
      "description": "Stores global application settings for the league.",
      "properties": {
        "currentSeasonId": { "type": "string" },
        "currentSeasonName": { "type": "string" },
        "isPlayoffEnabled": {
          "type": "boolean",
          "description": "Controls whether the playoff view is enabled for all users."
        },
        "isScoringInPlayoffMode": {
          "type": "boolean",
          "description": "Controls whether player stats tracking is in 'play-off' mode, which uses a separate counter."
        },
        "playoffSeries": {
          "type": "array",
          "description": "An array of objects representing playoff series.",
          "items": {
            "type": "object",
            "properties": {
              "round": {
                "type": "string",
                "enum": [
                  "Čtvrtfinále",
                  "Semifinále",
                  "Finále",
                  "Vítěz"
                ]
              },
              "opponent": {
                "type": "string"
              },
              "wins": {
                "type": "number"
              },
              "losses": {
                "type": "number"
              }
            },
            "required": [
              "round",
              "opponent",
              "wins",
              "losses"
            ]
          }
        },
        "leagueStandings": {
          "type": "array",
          "description": "An array of objects representing the league standings.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "points": {
                "type": "number"
              },
              "gf": {
                "type": "number"
              },
              "ga": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "name",
              "points",
              "gf",
              "ga"
            ]
          }
        }
      },
      "required": [
        "isPlayoffEnabled",
        "isScoringInPlayoffMode"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "UserProfile" }
      },
      {
        "path": "/users/{userId}/skaterStats/{skaterStatsId}",
        "definition": { "entityName": "SkaterStats" }
      },
      {
        "path": "/users/{userId}/goalieStats/{goalieStatsId}",
        "definition": { "entityName": "GoalieStats" }
      },
      {
        "path": "/matches/{matchId}",
        "definition": { "entityName": "Match" }
      },
      {
        "path": "/seasons/{seasonId}",
        "definition": { "entityName": "Season" }
      },
      {
        "path": "/settings/{settingId}",
        "definition": { "entityName": "AppSettings" }
      }
    ]
  }
}
